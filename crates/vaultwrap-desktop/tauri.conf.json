{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultwrap",
  "mainBinaryName": "vaultwrap-desktop",
  "identifier": "dev.vaultwrap.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vaultwrap",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 540,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Encrypted secrets vault and .env injector",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "MacOS/vaultwrap": "../../target/release/vaultwrap"
      }
    }
  }
}
